---
import StoreBadges from "./StoreBadges.astro";

const projects = [
  {
    title: "ListaCompra",
    description:
      "Una aplicación multiplataforma de lista de la compra desarrollada con Kotlin Multiplatform y Jetpack Compose, integrada con Firebase Firestore para sincronización en tiempo real.",
    tags: ["Kotlin", "Jetpack Compose", "Android e iOS"],
    play: "https://play.google.com/store/apps/details?id=dev.bonygod.listacompra",
    appStore: "https://apps.apple.com/es/app/id6758867523",
  },
  {
    title: "DisApp",
    description:
      "Aplicación móvil para la gestión de presupuestos en Aluminis Disa. Desarrollada en Android con Jetpack Compose.",
    tags: ["Android", "Jetpack Compose", "Kotlin"],
  },
  {
    title: "GymRoutine",
    description:
      "Aplicación multiplataforma para crear rutinas, registrar entrenamientos y seguir tu progreso en el gimnasio, con récords y estadísticas de constancia.",
    tags: ["Kotlin", "Jetpack Compose", "Android e iOS"],
  },
  {
    title: "SignInKMP",
    description:
      "Librería Kotlin Multiplatform para integrar Google Sign-In y Apple Sign-In con Firebase en aplicaciones Kotlin Multiplatform.",
    tags: ["KMP", "Kotlin", "Swift"],
  },
];
---

<section class="max-w-7xl mx-auto px-6 md:px-20 mb-32">
  <h2 class="text-3xl font-bold mb-2 pb-6">Mis últimos Proyectos</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {projects.map((project) => (
      <article class="bg-card-dark border border-white/5 rounded-xl p-6 hover:border-accent-red/50 transition flex flex-col justify-between h-full">
        <div>
          <h3 class="text-xl font-bold mb-4">{project.title}</h3>
          <p class="text-muted-grey text-sm mb-4">{project.description}</p>
        </div>
        <div class="mt-6">
          <div class="flex flex-wrap gap-2 text-xs">
            {project.tags.map((tag) => (
              <span class="bg-white/5 px-3 py-1 rounded">{tag}</span>
            ))}
          </div>
          {(project.play || project.appStore) && (
            <div class="mt-4">
              <StoreBadges play={project.play} appStore={project.appStore} compact />
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
