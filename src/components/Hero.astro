---
import StoreBadges from "./StoreBadges.astro";
import StatsBanner from "./StatsBanner.astro";

const PLAY = "https://play.google.com/store/apps/details?id=dev.bonygod.listacompra";
const APP_STORE = "https://apps.apple.com/es/app/id6758867523";
---

<section class="flex flex-col items-center text-center py-24">
  <div class="relative mb-8">
    <div class="absolute -inset-1 bg-accent-red/20 rounded-full blur-xl"></div>
    <img
      src="/Imagen_Perfil.webp"
      alt="Ivan Boniquet"
      class="relative w-44 h-44 rounded-full border-4 border-white/10 object-cover"
    />
  </div>

  <p class="text-accent-red font-mono text-sm tracking-[0.3em] uppercase mb-4">
    Full-Stack Developer
  </p>

  <h1 class="text-5xl md:text-7xl font-black tracking-tight mb-6">
    Ivan Boniquet
  </h1>

  <div class="w-full flex justify-center text-left px-6 mb-10">
    <StatsBanner years={10} projects={17} apps={2} />
  </div>

  <div class="flex gap-4">
    <a href="/projects" class="bg-black border border-white/10 px-8 py-4 rounded-xl font-bold hover:bg-accent-red transition hover:cursor-pointer block">
      Ver Proyectos
    </a>
    <a href="https://www.linkedin.com/in/ivanboniquet" target="_blank" class="border border-white/10 px-8 py-4 rounded-xl font-bold hover:bg-linkedin-color transition hover:cursor-pointer">
      Linkedin
    </a>
  </div>

  <div class="mt-12 flex flex-col items-center gap-4">
    <p class="text-muted-grey font-mono text-xs tracking-[0.2em] uppercase">
      ListaCompra, disponible en
    </p>
    <StoreBadges play={PLAY} appStore={APP_STORE} center />
  </div>
</section>