---
const current = {
  name: "Inditex · Proyecto Shopper",
  role: "Senior Software Developer",
  period: "abr. 2025 – actualidad",
  via: "NTT DATA",
  detail:
    "Formando parte de un equipo de desarrollo especializado en Android para el cliente Inditex en el proyecto Shopper.",
  tags: ["Android", "Kotlin", "Jetpack Compose"],
};

const jobs = [
  {
    name: "Ecoembes",
    role: "Tech Lead",
    period: "jul. 2024 – mar. 2025",
    via: "NTT DATA",
    detail:
      "Equipo de Operaciones de Ecoembes, gestionando un equipo de 5 desarrolladores y como responsable mobile de Android e iOS en los proyectos AIRE y Basuraleza.",
    tags: ["Kotlin", "Java"],
  },
  {
    name: "La Caixa · WIVAI",
    role: "Tech Lead Android & iOS",
    period: "ago. 2021 – jun. 2024",
    via: "NTT DATA",
    detail:
      "Liderando un equipo de 10 personas (3 Android, 3 iOS, 3 WEB y 1 QA) para el cliente La Caixa en el proyecto WIVAI.",
    tags: ["Kotlin", "Java"],
  },
  {
    name: "La Caixa · Negocios",
    role: "Tech Lead Android & iOS",
    period: "sept. 2019 – ago. 2021",
    via: "Everis",
    detail:
      "Analista programador y líder responsable de un equipo de desarrollo Android e iOS para el cliente La Caixa en el proyecto Negocios.",
    tags: ["Kotlin", "Java"],
  },
  {
    name: "DKV",
    role: "Analista programador .Net",
    period: "dic. 2018 – sept. 2019",
    via: "Everis",
    detail: "Análisis y desarrollo en el proyecto Autorizaciones para el cliente DKV.",
    tags: [".NET Core 2", "C#"],
  },
  {
    name: "Cirsa",
    role: "Analista programador .Net",
    period: "dic. 2016 – dic. 2018",
    via: null,
    detail:
      "Desarrollo de evolutivos y resolución de incidencias en aplicaciones de gestión, garantizando la continuidad del servicio.",
    tags: ["C#", "ASP.NET Web API"],
  },
  {
    name: "Planeta DeAgostini",
    role: "Programador .Net",
    period: "jun. 2016 – dic. 2016",
    via: null,
    detail:
      "Implementación del soporte multiidioma en las aplicaciones de Planeta DeAgostini, habilitando su despliegue en distintos mercados.",
    tags: ["ASP.NET"],
  },
  {
    name: "Edifici Gaia I+D",
    role: "Programador C# WPF",
    period: "ene. 2016 – may. 2016",
    via: null,
    detail:
      "Desarrollo de una librería de comunicación por puerto serie y ModBus RTU para el control de un inversor eléctrico.",
    tags: ["C#", "WPF"],
  },
];
---

<section class="mb-32">
  <div class="flex items-center gap-2 mb-4">
    <span class="h-px w-8 bg-accent-red"></span>
    <span class="text-accent-red text-xs font-bold tracking-[0.2em] uppercase">
      Trayectoria
    </span>
  </div>

  <h2 class="text-3xl font-bold mb-2 pb-6">Dónde he trabajado</h2>

  <article class="bg-card-dark border border-accent-red/30 rounded-xl p-8 mb-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="status-dot h-2 w-2 rounded-full bg-accent-red"></span>
      <span class="text-accent-red font-mono text-xs tracking-[0.2em] uppercase">
        Actualmente
      </span>
    </div>

    <h3 class="text-2xl font-bold mb-2">{current.name}</h3>
    <p class="text-white text-sm font-semibold mb-1">{current.role}</p>
    <p class="text-muted-grey font-mono text-xs mb-4">{current.period}</p>
    <p class="text-muted-grey text-sm mb-6">{current.detail}</p>

    <div class="flex flex-wrap gap-2 text-xs">
      <span class="bg-white/5 px-3 py-1 rounded">vía {current.via}</span>
      {current.tags.map((tag) => (
        <span class="bg-white/5 px-3 py-1 rounded">{tag}</span>
      ))}
    </div>
  </article>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {jobs.map((job) => (
      <article class="bg-card-dark border border-white/5 rounded-xl p-6 hover:border-accent-red/50 transition flex flex-col justify-between h-full">
        <div>
          <h3 class="text-xl font-bold mb-2">{job.name}</h3>
          <p class="text-accent-red font-mono text-xs tracking-[0.2em] uppercase mb-1">
            {job.role}
          </p>
          <p class="text-muted-grey font-mono text-xs mb-4">{job.period}</p>
          <p class="text-muted-grey text-sm mb-4">{job.detail}</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs mt-6">
          {job.via && <span class="bg-white/5 px-3 py-1 rounded">vía {job.via}</span>}
          {job.tags.map((tag) => (
            <span class="bg-white/5 px-3 py-1 rounded">{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
