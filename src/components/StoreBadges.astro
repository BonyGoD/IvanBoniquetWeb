---
const { play, appStore, compact = false, center = false } = Astro.props;

const PLAY_PATH = "M4.4 2.06a.7.7 0 0 0-1.05.61v18.66a.7.7 0 0 0 1.05.6l16.3-9.32a.7.7 0 0 0 0-1.22z";
const APPLE_PATH = "M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701";

const stores = [
  { url: play, label: "Google Play", path: PLAY_PATH },
  { url: appStore, label: "App Store", path: APPLE_PATH },
].filter((store) => store.url);
---

{stores.length > 0 && (
  <div class:list={["flex flex-wrap gap-3", center && "justify-center"]}>
    {stores.map((store) => (
      <a
        href={store.url}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "flex items-center border border-white/10 rounded-xl text-muted-grey hover:text-white hover:border-accent-red/50 transition",
          compact ? "gap-2 px-3 py-1.5" : "gap-3 px-5 py-3",
        ]}
      >
        <svg
          class:list={["shrink-0", compact ? "w-3.5 h-3.5" : "w-5 h-5"]}
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={store.path} />
        </svg>
        <span class:list={["font-bold", compact ? "text-xs" : "text-sm"]}>{store.label}</span>
      </a>
    ))}
  </div>
)}
